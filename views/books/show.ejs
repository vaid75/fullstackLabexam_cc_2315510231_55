<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <h1 class="card-title fw-bold text-primary display-5 mb-1"><%= book.title %></h1>
                    <h4 class="text-muted mb-4">by <%= book.author %></h4>
                    
                    <div class="d-flex align-items-center mb-4 gap-3">
                        <span class="badge bg-secondary fs-6 px-3 py-2"><%= book.genre %></span>
                        <div class="fs-5 text-warning">
                            <% for(let i=0; i<book.rating; i++) { %>★<% } %>
                            <% for(let i=book.rating; i<5; i++) { %>☆<% } %>
                        </div>
                    </div>
                    
                    <h5 class="fw-bold mt-4">Review:</h5>
                    <p class="card-text fs-5 text-secondary border-start border-4 border-primary ps-3 py-2 bg-light rounded-end"><%= book.review %></p>
                    
                    <div class="mt-4 text-muted border-top pt-3 d-flex justify-content-between">
                        <small><strong>Published Date:</strong> <%= new Date(book.publishedDate).toLocaleDateString() %></small>
                        <small><strong>Added By:</strong> <%= book.createdBy.username %></small>
                    </div>

                    <div class="mt-5 d-flex gap-2">
                        <a href="/books/<%= book._id %>/edit" class="btn btn-warning fw-bold px-4">Edit</a>
                        <form action="/books/<%= book._id %>?_method=DELETE" method="POST" class="d-inline">
                            <button class="btn btn-danger fw-bold px-4" onclick="return confirm('Are you sure you want to delete this book?')">Delete</button>
                        </form>
                        <a href="/books" class="btn btn-light border fw-bold ms-auto px-4">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
