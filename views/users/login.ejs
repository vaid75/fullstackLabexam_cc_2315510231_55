<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container d-flex justify-content-center align-items-center mt-5">
    <div class="row w-100">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-dark text-white text-center py-4">
                    <h3 class="mb-0 fw-bold">Login</h3>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form action="/login" method="POST" class="needs-validation" novalidate>
                        <div class="mb-3">
                            <label class="form-label text-muted fw-semibold" for="username">Username</label>
                            <input class="form-control form-control-lg bg-light border-0" type="text" id="username" name="username" required>
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please enter a username.</div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted fw-semibold" for="password">Password</label>
                            <input class="form-control form-control-lg bg-light border-0" type="password" id="password" name="password" required>
                            <div class="valid-feedback">Looks good!</div>
                            <div class="invalid-feedback">Please enter a password.</div>
                        </div>
                        <button class="btn btn-dark btn-lg w-100 fw-bold text-uppercase py-3" type="submit">Login</button>
                    </form>
                </div>
                <div class="card-footer text-center py-3 bg-white border-0">
                    <p class="mb-0 text-muted">Don't have an account? <a href="/register" class="text-dark fw-bold text-decoration-none">Register</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
